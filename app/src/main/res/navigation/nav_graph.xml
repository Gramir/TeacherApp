<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/courseListFragment">

    <fragment
        android:id="@+id/courseListFragment"
        android:name="com.example.teacherapp.presentation.fragment.course.CourseListFragment"
        android:label="Courses">

        <action
            android:id="@+id/action_courseList_to_assignments"
            app:destination="@id/assignmentListFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />

        <action
            android:id="@+id/action_courseList_to_attendance"
            app:destination="@id/attendanceFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />

        <action
            android:id="@+id/action_courseList_to_students"
            app:destination="@id/studentListFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <fragment
        android:id="@+id/assignmentListFragment"
        android:name="com.example.teacherapp.presentation.fragment.assignment.AssignmentListFragment"
        android:label="Assignments">

        <argument
            android:name="courseId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/attendanceFragment"
        android:name="com.example.teacherapp.presentation.fragment.attendance.AttendanceFragment"
        android:label="Attendance">

        <argument
            android:name="courseId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/studentListFragment"
        android:name="com.example.teacherapp.presentation.fragment.student.StudentListFragment"
        android:label="Students">

        <argument
            android:name="courseId"
            app:argType="string" />
    </fragment>

</navigation>